# Existing contact API and the configurator server/Worker. Never expose these as NEXT_PUBLIC.
RESEND_API_KEY=
RESEND_FROM=GG Software <website@ggsoftware.cz>
CONTACT_TO=info@ggsoftware.cz
TURNSTILE_SECRET_KEY=

# Public build-time settings. Use a Turnstile key restricted to your domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# GitHub Pages: URL of the deployed Worker, ending in /configuration.
# Next server deployment: /api/configuration.
# Empty on a static build: honest, prefilled email-client handoff.
NEXT_PUBLIC_CONFIGURATION_ENDPOINT=
